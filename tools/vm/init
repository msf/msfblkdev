#!/bin/sh
set -eu

/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev
/bin/busybox insmod /modules/ublk_drv.ko
/bin/busybox insmod /modules/xfs.ko
test -c /dev/ublk-control
/bin/busybox grep -q xfs /proc/filesystems
/bin/busybox grep -q ext4 /proc/filesystems
/bin/busybox awk 'NR > 1 { exit 1 }' /proc/swaps
memory_mib=0
for argument in $(/bin/busybox cat /proc/cmdline); do
  case "${argument}" in lab.memory_mib=*) memory_mib="${argument#lab.memory_mib=}" ;; esac
done
case "${memory_mib}" in ''|*[!0-9]*) exit 1 ;; esac
test "${memory_mib}" -ge 320
test "${memory_mib}" -le 4096
/bin/busybox awk -v target="$((memory_mib * 1024))" \
  '/^MemTotal:/ { if ($2 < target - 131072 || $2 >= target) exit 1; seen=1 }
  END { if (!seen) exit 1 }' /proc/meminfo
echo 'vm-probe: kernel'
/bin/busybox uname -a
echo 'vm-probe: memory'
/bin/busybox cat /proc/meminfo
echo 'vm-probe: swaps'
/bin/busybox cat /proc/swaps
echo 'vm-probe: modules'
/bin/busybox cat /proc/modules
echo "vm-probe: PASS configured_ram_mib=${memory_mib} swap=disabled ublk=available ext4=available xfs=available"
/bin/busybox poweroff -f
